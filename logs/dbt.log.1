  create  table "saas_dw"."dbt_test_failures"."relationships_stg_users_f228e4e98f65acc7d7910db1fdb02d94"
  
  
    as
  
  (
    
    
  
    
    

with child as (
    select account_id as from_field
    from "saas_dw"."staging"."stg_users"
    where account_id is not null
),

parent as (
    select account_id as to_field
    from "saas_dw"."staging"."stg_accounts"
)

select
    from_field

from child
left join parent
    on child.from_field = parent.to_field


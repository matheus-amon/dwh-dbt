        (feature not in ('core', 'core_dashboard')) as is_gated_feature,

        -- Weeks since the window start, used as a monotonic ordering key by downstream
        -- incremental logic.
        (event_date - 2023-01-01::date) as days_since_spine_start

    from renamed

)


  create  table "saas_dw"."dbt_test_failures"."dbt_utils_accepted_range_dim_plans_tier_rank__True__4__1"
  
  
    as
  
  (
    
    
  

with meet_condition as(
  select *
  from "saas_dw"."core"."dim_plans"
),

validation_errors as (
  select *
  from meet_condition
  where

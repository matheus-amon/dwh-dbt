  create  table "saas_dw"."dbt_test_failures"."relationships_stg_subscription_b08185206f97df777db631dbde7b5e87"
  
  
    as
  
  (
    
    
  
    
    

with child as (
    select account_id as from_field
    from "saas_dw"."staging"."stg_subscriptions"
    where account_id is not null
),

parent as (
    select account_id as to_field
    from "saas_dw"."staging"."stg_accounts"
)

select
    from_field

from child
left join parent
    on child.from_field = parent.to_field


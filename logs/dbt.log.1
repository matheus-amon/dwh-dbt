[0m07:03:42.884305 [debug] [Thread-1 (]: On model.saas_metrics_dw.mart_product_adoption: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "saas_metrics_dw", "target_name": "dev", "node_id": "model.saas_metrics_dw.mart_product_adoption"} */

  
    

  create  table "saas_dw"."marts"."mart_product_adoption__dbt_tmp"
  
  
    as
  
  (
    

with months as (

    select distinct month_start_date
    from "saas_dw"."core"."dim_date"

),

features as (

    

    select feature_name
    from (
        
        select cast('core' as varchar) as feature_name
        union all
        
        select cast('core_dashboard' as varchar) as feature_name
        union all
        
        select cast('data_export' as varchar) as feature_name
        union all
        
        select cast('api_access' as varchar) as feature_name
        union all
        
        select cast('sso' as varchar) as feature_name
        union all
        
        select cast('audit_log' as varchar) as feature_name
        union all
        
        select cast('advanced_analytics' as varchar) as feature_name
        
        
    ) as enumerated

),

feature_tiers as (

    

    select feature_name, min_tier_rank
    from (
        
        select
            cast('core' as varchar) as feature_name,
            cast(0 as integer)          as min_tier_rank
        union all
        
        select
            cast('core_dashboard' as varchar) as feature_name,
            cast(1 as integer)          as min_tier_rank
        union all
        
        select
            cast('data_export' as varchar) as feature_name,
            cast(2 as integer)          as min_tier_rank
        union all
        
        select
            cast('api_access' as varchar) as feature_name,
            cast(2 as integer)          as min_tier_rank
        union all
        
        select
            cast('sso' as varchar) as feature_name,
            cast(3 as integer)          as min_tier_rank
        union all
        
        select
            cast('audit_log' as varchar) as feature_name,
            cast(3 as integer)          as min_tier_rank
        union all
        
        select
            cast('advanced_analytics' as varchar) as feature_name,
            cast(4 as integer)          as min_tier_rank
        
        
    ) as enumerated

),

plans as (

    select * from "saas_dw"."core"."dim_plans"

),

-- The denominator: accounts paying on each plan in each month.
account_base as (

    select
        month_start_date,
        plan_code,
        count(*)                            as eligible_accounts,
        sum(mrr_usd)                        as eligible_mrr_usd

    from "saas_dw"."core"."fct_subscription_periods"
    where not is_churned_month
    group by month_start_date, plan_code

),

usage as (

    select
        date_trunc('month', event_date)::date    as month_start_date,
        feature,
        count(*)                                as feature_event_count,
        count(distinct account_id)              as accounts_using_feature,
        count(distinct user_id)                 as feature_active_users,
        count(distinct session_id)              as feature_session_count

    from "saas_dw"."core"."fct_product_events"
    group by 1, 2

),

-- Usage attributed to the tier the account was actually on during that month, so adoption is
-- never credited to a tier the account had not upgraded to yet.
attributed_usage as (

    select
        account_base.month_start_date,
        account_base.plan_code,
        usage.feature,
        sum(usage.feature_event_count)          as feature_event_count,
        count(distinct usage.account_id)        as accounts_using_feature,
        count(distinct usage.feature_active_users) as feature_active_users,
        count(distinct usage.feature_session_count) as feature_session_count

    from account_base
    inner join "saas_dw"."core"."fct_subscription_periods"
        on  fct_subscription_periods.month_start_date = account_base.month_start_date
        and fct_subscription_periods.plan_code = account_base.plan_code
        and not fct_subscription_periods.is_churned_month
    inner join usage
        on  usage.month_start_date = account_base.month_start_date
        and usage.feature in (select feature_name from features)

    group by 1, 2, 3

),

grid as (

    select
        months.month_start_date,
        features.feature_name                        as feature,
        plans.plan_code,
        plans.tier_rank,
        feature_tiers.min_tier_rank,
        coalesce(account_base.eligible_accounts, 0)  as eligible_accounts,
        coalesce(attributed_usage.accounts_using_feature, 0) as accounts_using_feature,
        coalesce(attributed_usage.feature_event_count, 0)     as feature_event_count,
        coalesce(attributed_usage.feature_active_users, 0)   as feature_active_users,
        coalesce(attributed_usage.feature_session_count, 0)   as feature_session_count

    from months
    cross join features
    cross join plans
    left join feature_tiers
        on feature_tiers.feature_name = features.feature_name
    left join account_base
        on  account_base.month_start_date = months.month_start_date
        and account_base.plan_code = plans.plan_code
    left join attributed_usage
        on  attributed_usage.month_start_date = months.month_start_date
        and attributed_usage.plan_code = plans.plan_code
        and attributed_usage.feature = features.feature_name

)

select
    md5(cast(coalesce(cast(month_start_date as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(feature as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(plan_code as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))
                                                            as sk_feature_adoption,
    month_start_date,
    dim_date.month_year,
    dim_date.year_number,
    dim_date.quarter_number,
    feature,
    plan_code,
    tier_rank,
    min_tier_rank,

    (min_tier_rank = 0)                                    as is_ungated_feature,
    (tier_rank >= min_tier_rank)                           as is_plan_entitled,

    eligible_accounts,
    -- Zero rather than null when the tier cannot reach the feature: the tier is not a
    -- candidate, and a null here would average into the rate as though it were.
    case
        when tier_rank >= min_tier_rank then eligible_accounts
        else 0
    end                                                     as entitled_accounts,
    accounts_using_feature,
    feature_event_count,
    feature_active_users,
    feature_session_count,

    -- Adoption across everyone on the tier.
    cast(accounts_using_feature as numeric)
        / nullif(cast(eligible_accounts as numeric), 0)  as adoption_rate,

    -- Adoption across the accounts that could actually reach it. NULL when nobody on the tier
    -- is entitled, because the question does not apply there.
    cast(accounts_using_feature as numeric)
        / nullif(cast(entitled_accounts as numeric), 0) as entitled_adoption_rate,

    (entitled_accounts - accounts_using_feature)             as entitled_not_adopting,

    cast(feature_event_count as numeric)
        / nullif(cast(accounts_using_feature as numeric), 0)
                                                            as events_per_adopting_account,

    cast(feature_active_users as numeric)
        / nullif(cast(accounts_using_feature as numeric), 0)
                                                            as users_per_adopting_account

from grid
inner join "saas_dw"."core"."dim_date"
    on dim_date.date_day = grid.month_start_date
  );
  
